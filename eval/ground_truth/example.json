      },
      "expected": {
        "findings": [
          {
            "resource_identity": "aws_s3_bucket.data",
            "issue_class": "storage-encryption-at-rest",
            "expected_band": "Medium"
          }
        ],
        "notes": "Identical to example-s3-public but with the public-access-block enabled."
      }
