  "cases": [
    {
      "case_id": "sg-default-low-exposure",
      "platform": "terraform",
      "domain": "networking",
      "source": {
        "repo": "https://github.com/bridgecrewio/terragoat",
        "commit": "729f8da6",
        "path": "terraform/aws/db-app.tf"
      },
      "declared_context": {
        "aws_security_group.default": {
          "sensitivity": 3,
          "criticality": 3
        }
      },
      "expected": {
        "findings": [
          {
            "resource_identity": "aws_security_group.default",
            "issue_class": "networking-config-hygiene"
          }
        ],
        "notes": "aws_security_group.default is declared in db-app.tf:117-134, not ec2.tf - verified against real adapter output over tests/harvest/fixtures/*-terraform.json (checkov CKV_AWS_23, trivy AWS-0099, tfsec AVD-AWS-0099, all mapping to networking-config-hygiene; no ingress/egress class). Serves as the low side of the exposure pair against sg-web-node-high-exposure: the group carries no rule of its own, only a naming-hygiene finding."
      }
    },
